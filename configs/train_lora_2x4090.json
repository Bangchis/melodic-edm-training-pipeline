{
  "base_model": "ACE-Step 1.5 XL-Base",
  "model_variant": "xl_base",
  "adapter_type": "lora",
  "rank": 32,
  "alpha": 64,
  "dropout": 0.1,
  "learning_rate": 0.0001,
  "batch_size_per_gpu": 1,
  "gradient_accumulation_steps": 8,
  "effective_batch_size": 16,
  "cfg_dropout_ratio": 0.15,
  "max_epochs": 150,
  "scheduler": "cosine",
  "optimizer": "adamw",
  "weight_decay": 0.01,
  "warmup_steps": 100,
  "num_devices": 2,
  "strategy": "ddp",
  "save_every_n_epochs": 5,
  "validate_every_n_epochs": 5,
  "early_stopping_patience_validations": 5,
  "sample_every_n_epochs": 10,
  "log_every_steps": 10,
  "log_heavy_every_steps": 50,
  "gradient_checkpointing": true,
  "split": {
    "train_ratio": 0.85,
    "validation_ratio": 0.15,
    "test_ratio": 0.0,
    "group_by_full_song": true,
    "seed": 42
  },
  "training_policy": "one_smoke_test_then_one_main_run_no_sweep"
}
