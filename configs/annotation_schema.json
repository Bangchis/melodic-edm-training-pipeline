{
  "name": "melodic_edm_master_annotation",
  "strict": true,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "primary_genre",
      "secondary_genres",
      "style_families",
      "moods",
      "main_instruments",
      "melody",
      "arrangement",
      "production",
      "canonical_caption",
      "caption_variants",
      "section_captions",
      "annotation_confidence"
    ],
    "properties": {
      "primary_genre": {
        "type": "string",
        "enum": ["melodic_edm", "progressive_house", "electro_house", "glitch_hop", "future_bass", "drumstep", "cinematic_electronic"]
      },
      "secondary_genres": {
        "type": "array",
        "maxItems": 3,
        "items": {
          "type": "string",
          "enum": ["melodic_edm", "progressive_house", "electro_house", "glitch_hop", "future_bass", "drumstep", "cinematic_electronic"]
        }
      },
      "style_families": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": {
          "type": "string",
          "enum": ["china_melodic", "gaming_melodic", "east_asian_fantasy", "kawaii_edm", "heroic_cinematic"]
        }
      },
      "moods": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
          "type": "string",
          "enum": ["uplifting", "adventurous", "energetic", "emotional", "dreamy", "heroic", "playful", "mysterious", "melancholic", "peaceful", "dark", "cinematic", "fantasy", "nostalgic", "tense"]
        }
      },
      "main_instruments": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "role", "confidence"],
          "properties": {
            "name": {
              "type": "string",
              "enum": ["pipa", "guzheng", "dizi", "erhu", "xiao", "taiko", "piano", "acoustic_guitar", "orchestral_strings", "brass", "choir_texture", "synth_pluck", "synth_lead", "supersaw", "electronic_drums", "sub_bass", "bass_guitar", "percussion", "bells", "unknown"]
            },
            "role": {
              "type": "string",
              "enum": ["main_melody", "main_hook", "counter_melody", "call_and_response", "melody_doubling", "chordal_texture", "rhythmic_texture", "bass", "drums", "accents", "atmosphere"]
            },
            "confidence": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      },
      "melody": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scale_character", "motif_length", "repetition", "register", "description"],
        "properties": {
          "scale_character": {"type": "string"},
          "motif_length": {"type": "string"},
          "repetition": {"type": "string"},
          "register": {"type": "string"},
          "description": {"type": "string"}
        }
      },
      "arrangement": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intro", "theme", "buildup", "drop", "break", "final_drop", "outro"],
        "properties": {
          "intro": {"type": "string"},
          "theme": {"type": "string"},
          "buildup": {"type": "string"},
          "drop": {"type": "string"},
          "break": {"type": "string"},
          "final_drop": {"type": "string"},
          "outro": {"type": "string"}
        }
      },
      "production": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bass", "chords", "drums", "space", "description"],
        "properties": {
          "bass": {"type": "string"},
          "chords": {"type": "string"},
          "drums": {"type": "string"},
          "space": {"type": "string"},
          "description": {"type": "string"}
        }
      },
      "canonical_caption": {"type": "string"},
      "caption_variants": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": {"type": "string", "enum": ["full", "composition", "production", "tags"]},
            "text": {"type": "string"}
          }
        }
      },
      "section_captions": {
        "type": "array",
        "maxItems": 12,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "caption"],
          "properties": {
            "label": {"type": "string", "enum": ["Intro", "Theme", "Build", "Drop", "Break", "Final Drop", "Outro"]},
            "caption": {"type": "string"}
          }
        }
      },
      "annotation_confidence": {"type": "number", "minimum": 0, "maximum": 1}
    }
  }
}
