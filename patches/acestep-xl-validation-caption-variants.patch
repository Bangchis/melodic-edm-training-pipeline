index 0000000..af03796
--- /dev/null
+++ b/acestep/training_v2/lora_scope_test.py
@@ -0,0 +1,67 @@
+"""Tests for strict self- and cross-attention LoRA verification."""
+
+from __future__ import annotations
+
+import unittest
+from types import SimpleNamespace
+
+import torch
+import torch.nn as nn
+
+from acestep.training_v2.lora_scope import verify_shared_attention_scope
+
+
+class PeftLikeLinear(nn.Module):
+    """Minimal PEFT-style wrapper used to reproduce the XL runtime shape."""
+
+    def __init__(self) -> None:
+        super().__init__()
+        self.base_layer = nn.Linear(2, 2)
+        self.base_layer.requires_grad_(False)
+        self.lora_A = nn.ParameterDict({"adapter": nn.Parameter(torch.ones(1))})
+
+
+class Attention(nn.Module):
+    def __init__(self) -> None:
+        super().__init__()
+        for name in ("q_proj", "k_proj", "v_proj", "o_proj"):
+            setattr(self, name, PeftLikeLinear())
+
+    def forward(self, hidden_states, encoder_hidden_states=None):
+        return hidden_states
+
+
+def complete_model() -> nn.Module:
+    return nn.ModuleDict({
+        "layers": nn.ModuleDict({
+            "0": nn.ModuleDict({
+                "self_attn": Attention(),
+                "cross_attn": Attention(),
+            })
+        })
+    })
+
+
+class LoraScopeTest(unittest.TestCase):
+    def test_accepts_peft_wrapped_self_and_cross_attention(self) -> None:
+        config = SimpleNamespace(target_modules=["q_proj", "k_proj", "v_proj", "o_proj"])
+        info = verify_shared_attention_scope(complete_model(), config)
+        self.assertEqual(1, info["self_attention_blocks"])
+        self.assertEqual(1, info["cross_attention_blocks"])
+        self.assertEqual(8, info["projection_modules"])
+
+    def test_rejects_incomplete_projection_set(self) -> None:
+        config = SimpleNamespace(target_modules=["q_proj", "v_proj"])
+        with self.assertRaisesRegex(ValueError, "requires exactly"):
+            verify_shared_attention_scope(complete_model(), config)
+
+    def test_rejects_missing_cross_attention(self) -> None:
+        model = complete_model()
+        del model["layers"]["0"]["cross_attn"]
+        config = SimpleNamespace(target_modules=["q_proj", "k_proj", "v_proj", "o_proj"])
+        with self.assertRaisesRegex(RuntimeError, "incomplete self/cross"):
+            verify_shared_attention_scope(model, config)
+
+
+if __name__ == "__main__":
+    unittest.main()
