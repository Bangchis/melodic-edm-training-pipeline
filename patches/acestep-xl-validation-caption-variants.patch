new file mode 100644
index 0000000..950d811
--- /dev/null
+++ b/acestep/training_v2/prompt_tracking.py
@@ -0,0 +1,55 @@
+"""Track random caption selections without changing the training batch."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any
+
+import torch
+
+
+def count_selected_variants(batch: dict[str, Any], counts: torch.Tensor) -> None:
+    """Add selected caption indices from a collated batch to *counts*."""
+    metadata = batch.get("metadata", {})
+    if not isinstance(metadata, dict):
+        return
+    selected = metadata.get("selected_caption_variant")
+    if selected is None:
+        return
+    values = selected.reshape(-1).tolist() if torch.is_tensor(selected) else [selected]
+    for value in values:
+        index = int(value)
+        if 0 <= index < counts.numel():
+            counts[index] += 1
+
+
+def save_prompt_counts(
+    output_dir: Path,
+    epoch: int,
+    epoch_counts: list[int],
+    cumulative_counts: list[int],
+) -> None:
+    """Atomically save prompt-selection evidence for smoke and full runs."""
+    path = output_dir / "prompt_selection_counts.json"
+    history = []
+    if path.is_file():
+        try:
+            history = json.loads(path.read_text(encoding="utf-8")).get("epochs", [])
+        except (OSError, json.JSONDecodeError):
+            history = []
+    history = [item for item in history if int(item.get("epoch", -1)) != epoch]
+    history.append({"epoch": epoch, "counts": epoch_counts})
+    cumulative_counts = [
+        sum(int(item.get("counts", [0, 0, 0])[index]) for item in history)
+        for index in range(3)
+    ]
+    value = {
+        "caption_variant_types": ["canonical", "composition", "production"],
+        "selection": "uniform_random_per_load",
+        "epochs": sorted(history, key=lambda item: int(item["epoch"])),
+        "cumulative_counts": cumulative_counts,
+    }
+    temporary = path.with_suffix(".json.tmp")
+    temporary.write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")
+    temporary.replace(path)
