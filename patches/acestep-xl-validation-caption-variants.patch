+++ b/acestep/training_v2/validation_loop.py
@@ -0,0 +1,61 @@
+"""Deterministic validation helpers for fixed ACE-Step training."""
+
+from __future__ import annotations
+
+import json
+from contextlib import nullcontext
+from pathlib import Path
+from typing import Any
+
+import torch
+
+
+def run_fabric_validation(module: Any, loader: Any, fabric: Any, seed: int) -> float:
+    """Return globally averaged validation loss across all Fabric ranks."""
+    decoder = module.model.decoder
+    decoder.eval()
+    device_index = fabric.device.index
+    devices = [device_index] if fabric.device.type == "cuda" and device_index is not None else []
+    local = torch.zeros(2, device=fabric.device, dtype=torch.float64)
+    rng_context = torch.random.fork_rng(devices=devices) if devices else nullcontext()
+    try:
+        with rng_context, torch.no_grad():
+            torch.manual_seed(seed)
+            for batch in loader:
+                loss = module.training_step(batch, apply_dropout=False, record_loss=False)
+                local[0] += loss.detach().double()
+                local[1] += 1
+    finally:
+        decoder.train()
+    totals = fabric.all_reduce(local, reduce_op="sum")
+    if totals[1].item() == 0:
+        raise RuntimeError("validation loader produced zero batches")
+    return float((totals[0] / totals[1]).item())
+
+
+def load_validation_state(output_dir: Path) -> tuple[float, int, int]:
+    """Load best loss, best epoch, and stale-check count for resume."""
+    path = output_dir / "validation_state.json"
+    if not path.is_file():
+        return float("inf"), 0, 0
+    data = json.loads(path.read_text(encoding="utf-8"))
+    return float(data["best_loss"]), int(data["best_epoch"]), int(data["stale_checks"])
+
+
+def save_validation_state(
+    output_dir: Path,
+    best_loss: float,
+    best_epoch: int,
+    stale_checks: int,
+    latest_loss: float,
+) -> None:
+    """Atomically save validation state used for resume and checkpoint choice."""
+    path = output_dir / "validation_state.json"
+    tmp = path.with_suffix(".json.tmp")
+    tmp.write_text(json.dumps({
+        "best_loss": best_loss,
+        "best_epoch": best_epoch,
+        "stale_checks": stale_checks,
+        "latest_loss": latest_loss,
+    }, indent=2) + "\n", encoding="utf-8")
+    tmp.replace(path)
