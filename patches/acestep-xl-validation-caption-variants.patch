+"""Append machine-readable training events for release evaluation."""
+
+from __future__ import annotations
+
+import json
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any
+
+
+def append_metric(output_dir: Path, event: str, **values: Any) -> None:
+    """Append one JSONL event from rank zero."""
+    output_dir.mkdir(parents=True, exist_ok=True)
+    record = {
+        "timestamp": datetime.now(timezone.utc).isoformat(),
+        "event": event,
+        **values,
+    }
+    with (output_dir / "metrics_history.jsonl").open("a", encoding="utf-8") as handle:
+        handle.write(json.dumps(record, sort_keys=True) + "\n")
+        handle.flush()
