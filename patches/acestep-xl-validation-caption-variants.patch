diff --git a/acestep/training_v2/caption_variants.py b/acestep/training_v2/caption_variants.py
new file mode 100644
index 0000000..23f4dd4
--- /dev/null
+++ b/acestep/training_v2/caption_variants.py
@@ -0,0 +1,60 @@
+"""Helpers for encoding and selecting multiple captions per audio sample."""
+
+from __future__ import annotations
+
+import random
+from typing import Any, Callable, Dict, List, Tuple
+
+import torch
+
+from acestep.training_v2.preprocess_prompt import build_simple_prompt
+
+
+def build_prompt_variants(
+    metadata: Dict[str, Any],
+    tag_position: str,
+    use_genre: bool,
+) -> List[str]:
+    """Build one formatted prompt per caption without duplicating a sample."""
+    raw = metadata.get("caption_variants")
+    captions = [value.strip() for value in raw or [] if isinstance(value, str) and value.strip()]
+    if not captions:
+        return [build_simple_prompt(metadata, tag_position=tag_position, use_genre=use_genre)]
+
+    prompts = []
+    for caption in captions:
+        variant_meta = dict(metadata)
+        variant_meta["caption"] = caption
+        variant_meta["prompt_override"] = "caption"
+        prompts.append(build_simple_prompt(variant_meta, tag_position=tag_position, use_genre=False))
+    return prompts
+
+
+def encode_prompt_variants(
+    prompts: List[str],
+    encode: Callable[[str], Tuple[torch.Tensor, torch.Tensor]],
+) -> Tuple[List[torch.Tensor], List[torch.Tensor]]:
+    """Encode each prompt and return parallel hidden-state and mask lists."""
+    states = []
+    masks = []
+    for prompt in prompts:
+        hidden, mask = encode(prompt)
+        states.append(hidden.cpu())
+        masks.append(mask.cpu())
+    return states, masks
+
+
+def select_encoded_variant(
+    data: Dict[str, Any], index: int | None = None
+) -> Tuple[torch.Tensor, torch.Tensor, int]:
+    """Randomly select one encoded caption, with legacy single-caption fallback."""
+    states = data.get("encoder_hidden_states_variants")
+    masks = data.get("encoder_attention_mask_variants")
+    if not states or not masks:
+        return data["encoder_hidden_states"], data["encoder_attention_mask"], 0
+    if len(states) != len(masks):
+        raise ValueError("caption variant state/mask counts differ")
+    index = random.randrange(len(states)) if index is None else index
+    if not 0 <= index < len(states):
+        raise IndexError("caption variant index is out of range")
+    return states[index], masks[index], index
diff --git a/acestep/training_v2/caption_variants_test.py b/acestep/training_v2/caption_variants_test.py
new file mode 100644
index 0000000..545f17d
--- /dev/null
+++ b/acestep/training_v2/caption_variants_test.py
@@ -0,0 +1,53 @@
+"""Tests for random caption variants without sample duplication."""
+
+from __future__ import annotations
+
+import unittest
+from unittest.mock import patch
+
+import torch
+
+from acestep.training_v2.caption_variants import build_prompt_variants, select_encoded_variant
+
+
+class CaptionVariantsTest(unittest.TestCase):
+    """Cover multi-caption and backward-compatible single-caption behavior."""
+
+    def test_builds_one_prompt_per_caption(self) -> None:
+        metadata = {
+            "caption": "primary",
+            "caption_variants": ["full caption", "composition caption", "production caption", "tag caption"],
+            "duration": 120,
+        }
+        prompts = build_prompt_variants(metadata, tag_position="prepend", use_genre=False)
+        self.assertEqual(4, len(prompts))
+        self.assertIn("full caption", prompts[0])
+        self.assertIn("tag caption", prompts[-1])
+
+    def test_selects_requested_variant(self) -> None:
+        states = [torch.full((2, 3), value) for value in (1.0, 2.0, 3.0, 4.0)]
+        masks = [torch.full((2,), value) for value in (1.0, 2.0, 3.0, 4.0)]
+        data = {
+            "encoder_hidden_states_variants": states,
+            "encoder_attention_mask_variants": masks,
+        }
+        with patch("acestep.training_v2.caption_variants.random.randrange", return_value=2):
+            state, mask, index = select_encoded_variant(data)
+        self.assertEqual(2, index)
+        self.assertTrue(torch.equal(states[2], state))
+        self.assertTrue(torch.equal(masks[2], mask))
+
+    def test_legacy_tensor_falls_back_to_single_caption(self) -> None:
+        state = torch.ones(2, 3)
+        mask = torch.ones(2)
+        selected_state, selected_mask, index = select_encoded_variant({
+            "encoder_hidden_states": state,
+            "encoder_attention_mask": mask,
+        })
+        self.assertEqual(0, index)
+        self.assertIs(state, selected_state)
+        self.assertIs(mask, selected_mask)
+
+
+if __name__ == "__main__":
+    unittest.main()
