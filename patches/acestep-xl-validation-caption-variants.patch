+"""Regression tests for XL checkpoint alias validation."""
+
+from __future__ import annotations
+
+import argparse
+import tempfile
+import unittest
+from pathlib import Path
+
+from acestep.training_v2.cli.validation import validate_paths
+
+
+class ValidationXLTest(unittest.TestCase):
+    """Ensure xl_base resolves to its official checkpoint folder."""
+
+    def test_xl_base_alias_resolves(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            expected = root / "acestep-v15-xl-base"
+            expected.mkdir()
+            args = argparse.Namespace(
+                checkpoint_dir=str(root),
+                model_variant="xl_base",
+                dataset_dir=None,
+                validation_dataset_dir=None,
+                validate_every=5,
+                early_stopping_patience=5,
+                resume_from=None,
+            )
+            self.assertTrue(validate_paths(args))
+            self.assertEqual(expected, args.model_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
