+"""Tests for validation-state persistence."""
+
+from __future__ import annotations
+
+import tempfile
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+
+import torch
+
+from acestep.training_v2.validation_loop import load_validation_state, save_validation_state
+
+
+class ValidationStateTest(unittest.TestCase):
+    """Verify fresh and resumed validation state."""
+
+    def test_missing_state_uses_fresh_defaults(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            loss, epoch, stale = load_validation_state(Path(tmp))
+        self.assertEqual(float("inf"), loss)
+        self.assertEqual((0, 0), (epoch, stale))
+
+    def test_state_round_trip(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp)
+            save_validation_state(path, 0.25, 10, 2, 0.3)
+            self.assertEqual((0.25, 10, 2), load_validation_state(path))
+
+    def test_validation_averages_batches_without_cfg_dropout(self) -> None:
+        calls = []
+
+        class Module:
+            model = SimpleNamespace(decoder=torch.nn.Linear(1, 1))
+
+            @staticmethod
+            def training_step(batch, apply_dropout=True, record_loss=True):
+                calls.append((apply_dropout, record_loss))
+                return batch["loss"]
+
+        fabric = SimpleNamespace(
+            device=torch.device("cpu"),
+            all_reduce=lambda value, reduce_op: value,
+        )
+        from acestep.training_v2.validation_loop import run_fabric_validation
+
+        loss = run_fabric_validation(
+            Module(),
+            [{"loss": torch.tensor(1.0)}, {"loss": torch.tensor(3.0)}],
+            fabric,
+            seed=42,
+        )
+        self.assertEqual(2.0, loss)
+        self.assertEqual([(False, False), (False, False)], calls)
+
+
+if __name__ == "__main__":
+    unittest.main()
