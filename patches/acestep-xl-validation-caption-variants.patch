diff --git a/acestep/training_v2/lora_scope.py b/acestep/training_v2/lora_scope.py
new file mode 100644
index 0000000..90a42e9
--- /dev/null
+++ b/acestep/training_v2/lora_scope.py
@@ -0,0 +1,99 @@
+"""Strictly verify ACE-Step self- and cross-attention LoRA scope."""
+
+from __future__ import annotations
+
+import inspect
+import re
+from typing import Any
+
+import torch.nn as nn
+
+
+REQUIRED_PROJECTIONS = {"q_proj", "k_proj", "v_proj", "o_proj"}
+ATTENTION_PARAMETER = re.compile(
+    r"(?:^|\.)(self_attn|cross_attn)\.(q_proj|k_proj|v_proj|o_proj)\.lora_"
+)
+
+
+def _is_linear_projection(module: nn.Module) -> bool:
+    """Accept a raw Linear or PEFT's Linear wrapper around one."""
+    return isinstance(module, nn.Linear) or isinstance(
+        getattr(module, "base_layer", None), nn.Linear
+    )
+
+
+def verify_shared_attention_scope(model: nn.Module, config: Any) -> dict[str, Any]:
+    """Verify exact q/k/v/o LoRA coverage on XL self and cross attention."""
+    requested = {str(value).rsplit(".", 1)[-1] for value in config.target_modules}
+    if requested != REQUIRED_PROJECTIONS:
+        raise ValueError(
+            "strict attention scope requires exactly q_proj,k_proj,v_proj,o_proj; "
+            f"received {sorted(requested)}"
+        )
+
+    scope_blocks: dict[str, list[str]] = {"self_attn": [], "cross_attn": []}
+    unexpected_blocks: list[str] = []
+    missing_lora: list[str] = []
+    for name, module in model.named_modules():
+        projections = {field: getattr(module, field, None) for field in REQUIRED_PROJECTIONS}
+        if not all(_is_linear_projection(value) for value in projections.values()):
+            continue
+        scope = name.rsplit(".", 1)[-1]
+        if scope not in scope_blocks:
+            unexpected_blocks.append(name)
+            continue
+        parameters = inspect.signature(module.forward).parameters
+        if "encoder_hidden_states" not in parameters:
+            raise RuntimeError(f"attention block {name} lacks encoder_hidden_states input")
+        scope_blocks[scope].append(name)
+        for projection, layer in projections.items():
+            if not any(
+                "lora_" in parameter_name and parameter.requires_grad
+                for parameter_name, parameter in layer.named_parameters()
+            ):
+                missing_lora.append(f"{name}.{projection}")
+
+    if unexpected_blocks:
+        raise RuntimeError(f"q/k/v/o projection block outside attention scope: {unexpected_blocks[:10]}")
+    self_count = len(scope_blocks["self_attn"])
+    cross_count = len(scope_blocks["cross_attn"])
+    if self_count == 0 or cross_count == 0 or self_count != cross_count:
+        raise RuntimeError(
+            "incomplete self/cross attention block coverage: "
+            f"self={self_count}, cross={cross_count}"
+        )
+    if missing_lora:
+        raise RuntimeError(f"attention projections missing trainable LoRA: {missing_lora[:10]}")
+
+    trainable = [name for name, parameter in model.named_parameters() if parameter.requires_grad]
+    unexpected = [name for name in trainable if "lora_" not in name]
+    if unexpected:
+        raise RuntimeError(f"non-LoRA parameters are trainable: {unexpected[:10]}")
+    wrong_scope = [name for name in trainable if ATTENTION_PARAMETER.search(name) is None]
+    if wrong_scope:
+        raise RuntimeError(f"trainable LoRA outside self/cross q/k/v/o scope: {wrong_scope[:10]}")
+
+    observed = {
+        (match.group(1), match.group(2))
+        for name in trainable
+        if (match := ATTENTION_PARAMETER.search(name)) is not None
+    }
+    expected = {
+        (scope, projection)
+        for scope in scope_blocks
+        for projection in REQUIRED_PROJECTIONS
+    }
+    if observed != expected:
+        raise RuntimeError(
+            "LoRA trainable scope mismatch: "
+            f"missing={sorted(expected - observed)}, extra={sorted(observed - expected)}"
+        )
+    return {
+        "attention_blocks": self_count + cross_count,
+        "self_attention_blocks": self_count,
+        "cross_attention_blocks": cross_count,
+        "projection_modules": (self_count + cross_count) * len(REQUIRED_PROJECTIONS),
+        "target_modules": sorted(REQUIRED_PROJECTIONS),
+        "attention_semantics": "separate_self_and_cross_attention_projections",
+        "trainable_parameter_tensors": len(trainable),
+    }
