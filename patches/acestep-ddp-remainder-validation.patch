new file mode 100644
index 0000000..e1c4191
--- /dev/null
+++ b/acestep/training_v2/accumulation.py
@@ -0,0 +1,46 @@
+"""Exact DDP gradient-accumulation semantics for partial epoch tails."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable
+
+import torch
+
+
+def should_sync_gradient(
+    accumulation_step: int,
+    gradient_accumulation_steps: int,
+    batch_index: int,
+    loader_length: int,
+) -> bool:
+    """Sync on a full accumulation boundary or the final batch of an epoch."""
+    if gradient_accumulation_steps <= 0:
+        raise ValueError("gradient_accumulation_steps must be positive")
+    if loader_length <= 0:
+        raise ValueError("loader_length must be positive")
+    return (
+        accumulation_step + 1 >= gradient_accumulation_steps
+        or batch_index + 1 >= loader_length
+    )
+
+
+def rescale_remainder_gradients(
+    parameters: Iterable[torch.nn.Parameter],
+    accumulation_step: int,
+    gradient_accumulation_steps: int,
+) -> float:
+    """Restore average-gradient magnitude for a partial accumulation tail.
+
+    Every microbatch loss is divided by the configured accumulation target.
+    A tail with fewer microbatches therefore needs ``target / observed``
+    scaling before clipping and the optimizer step.
+    """
+    if not 0 < accumulation_step <= gradient_accumulation_steps:
+        raise ValueError("accumulation_step must be in [1, gradient_accumulation_steps]")
+    scale = gradient_accumulation_steps / accumulation_step
+    if scale == 1.0:
+        return scale
+    for parameter in parameters:
+        if parameter.grad is not None:
+            parameter.grad.mul_(scale)
+    return scale
diff --git a/acestep/training_v2/accumulation_test.py b/acestep/training_v2/accumulation_test.py
new file mode 100644
index 0000000..f348b13
--- /dev/null
+++ b/acestep/training_v2/accumulation_test.py
@@ -0,0 +1,37 @@
+"""Regression tests for DDP accumulation tails."""
+
+from __future__ import annotations
+
+import unittest
+
+import torch
+
+from acestep.training_v2.accumulation import (
+    rescale_remainder_gradients,
+    should_sync_gradient,
+)
+
+
+class DDPAccumulationTailTest(unittest.TestCase):
+    def test_final_partial_batch_forces_ddp_sync(self) -> None:
+        self.assertFalse(should_sync_gradient(2, 8, 90, 92))
+        self.assertTrue(should_sync_gradient(3, 8, 91, 92))
+        self.assertTrue(should_sync_gradient(7, 8, 39, 92))
+
+    def test_four_of_eight_tail_restores_average_gradient_scale(self) -> None:
+        parameter = torch.nn.Parameter(torch.ones(1))
+        parameter.grad = torch.tensor([0.5])
+        scale = rescale_remainder_gradients([parameter], 4, 8)
+        self.assertEqual(2.0, scale)
+        self.assertTrue(torch.equal(parameter.grad, torch.tensor([1.0])))
+
+    def test_full_accumulation_does_not_rescale(self) -> None:
+        parameter = torch.nn.Parameter(torch.ones(1))
+        parameter.grad = torch.tensor([0.5])
+        scale = rescale_remainder_gradients([parameter], 8, 8)
+        self.assertEqual(1.0, scale)
+        self.assertTrue(torch.equal(parameter.grad, torch.tensor([0.5])))
+
+
+if __name__ == "__main__":
+    unittest.main()
